// Esquema de base de datos - PostgreSQL
// Cubre las entidades principales derivadas de los RF documentados
// en docs/Req_y_Estructura.docx

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Catalogo de codigos CIE-10 de uso frecuente (no el catalogo oficial
// completo de la OMS, sino un subconjunto curado para agilizar la captura
// con autocompletado en Diagnostico e Ingreso/Egreso).
model CatalogoCie10 {
  id          Int    @id @default(autoincrement())
  codigo      String @unique
  descripcion String

  @@index([descripcion])
}

// Modulo 8: Seguridad y Roles
model Usuario {
  id                    Int      @id @default(autoincrement())
  nombre                String
  correo                String   @unique
  passwordHash          String
  roles                 String[] @default([]) // uno o mas de: Administrador, Recepcion, Consulta, Enfermeria, Facturacion, Farmacia (RF-30)
  puedeAutogenerarToken Boolean  @default(false) // RF-34
  // Sprint 1: catalogo de medicos. Un usuario con rol clinico puede tener
  // numero de colegiado y especialidad, que se autocompletan al seleccionarlo
  // como medico responsable de una receta.
  colegiado         String? // numero de colegiado activo
  especialidad      String?
  ultimaActividad       DateTime? // se actualiza en cada peticion autenticada, para saber quien esta "en linea"
  creadoEn              DateTime @default(now())

  tokensRecibidos  TokenTemporal[] @relation("TokenUsuario")
  tokensEmitidos   TokenTemporal[] @relation("TokenEmisor")
  diagnosticos     Diagnostico[]   @relation("DiagnosticoRegistradoPor")
  recetas          Receta[]        @relation("RecetaMedico")
  visitasRegistradas BitacoraVisita[] @relation("BitacoraAutor")
  facturasFarmacia FacturaFarmacia[] @relation("FacturaFarmaciaRegistradoPor")
  accesosDiagnostico AccesoDiagnostico[] @relation("AccesoDiagnosticoUsuario")
  logs             LogActividad[]  @relation("LogActividadUsuario")
  passwordResetTokens PasswordResetToken[]
}

// Sprint 2: tokens de recuperacion de contrasena. Se guarda el hash SHA-256
// del token (nunca el token en claro) con expiracion de 30 minutos y uso
// unico. La respuesta de "forgot-password" es anti-enumeracion: no revela
// si el correo existe o no.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  usuarioId Int
  tokenHash String    @unique
  expiraEn  DateTime
  usado     Boolean   @default(false)
  creadoEn  DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([expiraEn])
}

// Bitacora general del sistema: login/logout y cada accion de crear o
// modificar algo, en cualquier modulo. No reemplaza a AccesoDiagnostico
// (ese es especifico para el diagnostico confidencial, RNF-08); esta es
// la traza general de "quien hizo que y cuando".
model LogActividad {
  id        Int      @id @default(autoincrement())
  usuarioId Int?
  accion    String   // "login" | "logout" | "crear_paciente" | "generar_factura_hospital" | ...
  detalle   String?  // contexto legible, ej. "Paciente HC-2026-000002"
  fecha     DateTime @default(now())

  usuario Usuario? @relation("LogActividadUsuario", fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([fecha])
  @@index([accion])
}

model TokenTemporal {
  id          Int      @id @default(autoincrement())
  token       String   @unique // valor aleatorio enviado en el header x-temp-token
  usuarioId   Int
  pacienteId  Int?
  emitidoPor  Int      // id del Administrador que lo genero (o el mismo usuario si autogenerado)
  expiraEn    DateTime
  usado       Boolean  @default(false) // RNF-12: un solo uso
  creadoEn    DateTime @default(now())

  usuario  Usuario   @relation("TokenUsuario", fields: [usuarioId], references: [id])
  emisor   Usuario   @relation("TokenEmisor", fields: [emitidoPor], references: [id])
  paciente Paciente? @relation(fields: [pacienteId], references: [id])
  accesos  AccesoDiagnostico[]

  @@index([usuarioId])
  @@index([expiraEn])
}

// Modulo 1: Registro y Admision
model Paciente {
  id                 Int       @id @default(autoincrement())
  historiaClinica    String    @unique // RF-03, generado automaticamente
  nombreCompleto     String
  dpi                String    @unique // RF-04, evita duplicados
  direccion          String?
  lugarNacimiento    String?
  fechaNacimiento    DateTime?
  telefono           String?
  edad               Int?
  sexo               String?
  tipoSangre         String? // A+, A-, B+, B-, AB+, AB-, O+, O-
  estadoCivil        String?
  ocupacion          String?
  religion           String?
  nacionalidad       String?
  nombreConyuge      String?
  nombrePadre        String?
  nombreMadre        String?
  contactoEmergencia String? // nombre de la persona a contactar
  telefonoEmergencia String? // telefono de esa misma persona
  parentesco         String?
  // Sprint 1: encargado legal o administrativo del paciente, separado del
  // contacto de emergencia (pueden ser personas distintas).
  encargadoNombre    String?
  encargadoTelefono  String?

  // RF-05: ingreso
  referidoDe         String? // institucion o medico, texto libre
  medicoReferenteId  Int?    // si el referente es un medico registrado (Modulo 4)
  serviciosSolicitados String?
  impresionClinicaIngreso String?
  fechaIngreso       DateTime?

  // RF-06/RF-08: egreso
  fechaEgreso        DateTime?
  diagnosticoEgresoCodigo String?
  complicacionesCodigo    String?
  operacionesCodigo       String?
  condicionEgreso    String? // curado, contraindicado, referido, mejorado, fallecido_antes_48, fallecido_despues_48
  autopsia           Boolean?
  causaMuerte        String?

  creadoEn DateTime @default(now())

  medicoReferente    MedicoReferente?     @relation(fields: [medicoReferenteId], references: [id])
  maternidad         RegistroMaternidad?
  egresoClinico      EgresoClinico?
  anexos             AnexoPaciente[]
  diagnosticos       Diagnostico[]
  tratamientos       TratamientoItem[]
  recetas            Receta[]
  facturasHospital   FacturaHospital[]
  visitas            BitacoraVisita[]
  tokensTemporales   TokenTemporal[]
  accesosDiagnostico AccesoDiagnostico[]
  facturasFarmacia   FacturaFarmacia[]

  @@index([nombreCompleto])
  @@index([fechaIngreso])
  @@index([fechaEgreso])
}

// Sprint 1: datos clinicos de egreso (RF-06/RF-08) separados de los datos
// administrativos del Paciente y cifrados con AES-256-GCM. El payload
// cifrado contiene: diagnostico de egreso (codigo y texto), complicaciones,
// operaciones, autopsia y causa de muerte. Solo fechaEgreso y
// condicionEgreso (administrativos, no sensibles) permanecen en Paciente.
// Las columnas de texto plano legacy se mantienen temporalmente hasta
// validar la migracion historica (ver scripts/migrar-egreso-cifrado.js).
model EgresoClinico {
  id           Int      @id @default(autoincrement())
  pacienteId   Int      @unique // relacion uno a uno con Paciente
  textoCifrado String   // payload JSON cifrado (AES-256-GCM)
  iv           String
  authTag      String
  creadoEn     DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  paciente Paciente @relation(fields: [pacienteId], references: [id])
}

// Sprint 1: repositorio general de anexos y expedientes escaneados a nivel
// de paciente, independiente de los adjuntos de estudios del diagnostico.
// El contenido binario vive cifrado en el volumen de uploads; esta fila
// solo guarda metadatos no sensibles (el nombre interno es aleatorio).
model AnexoPaciente {
  id             Int      @id @default(autoincrement())
  pacienteId     Int
  nombreOriginal String
  nombreArchivo  String   // nombre interno aleatorio generado por el servidor
  mimeType       String
  tamano         Int
  creadoEn       DateTime @default(now())

  paciente Paciente @relation(fields: [pacienteId], references: [id])

  @@index([pacienteId])
}

// RF-07: seccion de maternidad (cuando aplica)
model RegistroMaternidad {
  id                Int      @id @default(autoincrement())
  pacienteId        Int      @unique
  numeroHijo        Int?
  fecha             DateTime?
  hora              String?
  sexo              String?
  condicionEgresoBebe String?

  paciente Paciente @relation(fields: [pacienteId], references: [id])
}

// Modulo 2: Expediente Clinico
model Diagnostico {
  id             Int      @id @default(autoincrement())
  pacienteId     Int
  textoCifrado   String   // RF-10: contenido cifrado (AES-256-GCM) — JSON con la plantilla estructurada
  iv             String
  authTag        String
  codigoCie      String?
  tipoAtencion   String?  // consulta_externa | emergencia | hospitalizacion | seguimiento
  servicio       String?
  salaCama       String?
  registradoPor  Int
  creadoEn       DateTime @default(now())

  paciente  Paciente @relation(fields: [pacienteId], references: [id])
  registrador Usuario @relation("DiagnosticoRegistradoPor", fields: [registradoPor], references: [id])

  @@index([pacienteId])
}

// Archivo adjunto a un estudio dentro de "Estudios y resultados" del
// diagnostico (ver ExpedientePage). Se referencia por id desde el JSON
// cifrado (datos.estudios[i].archivoId) — el archivo en si vive en disco
// (backend/uploads/diagnosticos), esta fila solo guarda el nombre y el
// dueño (pacienteId) para poder validar el acceso con el mismo token
// temporal que protege el diagnostico (RF-11).
model DiagnosticoArchivo {
  id             Int      @id @default(autoincrement())
  pacienteId     Int
  nombreOriginal String
  nombreArchivo  String   // nombre generado en disco
  mimeType       String
  tamano         Int
  creadoEn       DateTime @default(now())

  @@index([pacienteId])
}

// RNF-08: trazabilidad de quien vio o registro el diagnostico confidencial
// de cada paciente y cuando. Se crea un registro cada vez que GET o POST
// /expedientes/paciente/:id responde con exito (Administrador directo, o
// con token temporal).
model AccesoDiagnostico {
  id         Int      @id @default(autoincrement())
  pacienteId Int
  usuarioId  Int
  accion     String   @default("ver") // "ver" | "registrar" (nuevo registro/edicion del diagnostico)
  viaToken   Boolean  @default(false) // false = acceso directo del Administrador (RF-11)
  tokenId    Int?
  fecha      DateTime @default(now())

  paciente Paciente       @relation(fields: [pacienteId], references: [id])
  usuario  Usuario        @relation("AccesoDiagnosticoUsuario", fields: [usuarioId], references: [id])
  token    TokenTemporal? @relation(fields: [tokenId], references: [id])

  @@index([pacienteId])
  @@index([usuarioId])
  @@index([fecha])
}

// Modulo 3: Tratamiento y Medicamentos Intrahospitalarios
model TratamientoItem {
  id           Int      @id @default(autoincrement())
  pacienteId   Int
  descripcion  String
  dosis        String?
  costo        Decimal  @db.Decimal(10, 2)
  origen       String   // "intrahospitalario" (insumo/procedimiento) | "farmacia" (medicamento de farmacia usado en el paciente)
  // RF-13: personal medico de un procedimiento quirurgico. Opcionales porque
  // no todo TratamientoItem es una cirugia (ej. una sonda o un medicamento).
  cirujano       String?
  ayudante       String?
  instrumentista String?
  anestesiologo  String?
  // RF-15: ambos origenes se cargan al costeo del paciente (FacturaHospital);
  // solo una venta directa de farmacia (VentaFarmacia) se factura aparte.
  facturado    Boolean  @default(false) // evita doble cobro al facturar (RNF-13)
  fecha        DateTime @default(now())

  paciente Paciente @relation(fields: [pacienteId], references: [id])

  @@index([pacienteId])
}

model Receta {
  id             Int      @id @default(autoincrement())
  pacienteId     Int
  medicoId       Int
  medicamento    String
  dosis          String
  indicaciones   String
  duracion       String
  creadoEn       DateTime @default(now())

  paciente Paciente @relation(fields: [pacienteId], references: [id])
  medico   Usuario  @relation("RecetaMedico", fields: [medicoId], references: [id])

  @@index([pacienteId])
}

// Modulo 4: Clientes Referidos
model MedicoReferente {
  id            Int      @id @default(autoincrement())
  nombre        String
  especialidad  String?
  comisionQ     Decimal  @db.Decimal(10, 2)
  creadoEn      DateTime @default(now())

  pacientesReferidos Paciente[]
}

// Modulo 5: Area Financiera
model FacturaHospital {
  id               Int      @id @default(autoincrement())
  pacienteId       Int
  costoHospital    Decimal  @db.Decimal(10, 2)
  costoTratamiento Decimal  @db.Decimal(10, 2)
  total            Decimal  @db.Decimal(10, 2)
  formaPago        String   // "transferencia" | "efectivo"
  creadoEn         DateTime @default(now())

  paciente Paciente @relation(fields: [pacienteId], references: [id])

  @@index([pacienteId])
  @@index([creadoEn])
}

// RF-20/RF-24/RF-27: factura de farmacia (cabecera). Agrupa una o mas
// ventas de medicamentos en un solo cobro; puede quedar a nombre de un
// paciente (opcional, solo para su registro/trazabilidad, no se carga al
// costeo del hospital -- eso es uso intrahospitalario, ver TratamientoItem).
model FacturaFarmacia {
  id            Int      @id @default(autoincrement())
  pacienteId    Int?
  montoTotal    Decimal  @db.Decimal(10, 2)
  registradoPor Int
  creadoEn      DateTime @default(now())

  paciente    Paciente?       @relation(fields: [pacienteId], references: [id])
  registrador Usuario         @relation("FacturaFarmaciaRegistradoPor", fields: [registradoPor], references: [id])
  items       VentaFarmacia[]

  @@index([pacienteId])
  @@index([creadoEn])
}

// Modulo 6: Farmacia (independiente, vision a futuro)
model MedicamentoInventario {
  id               Int      @id @default(autoincrement())
  nombre           String
  tipo             String?
  presentacion     String?
  stock            Int      @default(0)
  stockMinimo      Int      @default(10) // RF-25
  precioVenta      Decimal  @db.Decimal(10, 2) @default(0)
  fechaVencimiento DateTime? // RF-26
  proveedor        String?

  movimientos MovimientoInventario[]
  ventas      VentaFarmacia[]

  @@index([nombre])
}

model MovimientoInventario {
  id             Int      @id @default(autoincrement())
  medicamentoId  Int
  tipo           String   // "entrada" | "salida"
  cantidad       Int
  motivo         String?  // "venta directa" | "uso intrahospitalario" | "compra"
  fecha          DateTime @default(now())

  medicamento MedicamentoInventario @relation(fields: [medicamentoId], references: [id])

  @@index([medicamentoId])
  @@index([fecha])
}

// Linea de detalle de una venta directa de farmacia (un medicamento dentro
// de una FacturaFarmacia). Cada linea descuenta stock y deja su propio
// movimiento de inventario.
model VentaFarmacia {
  id             Int      @id @default(autoincrement())
  facturaId      Int
  medicamentoId  Int
  cantidad       Int
  precioUnitario Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
  creadoEn       DateTime @default(now())

  factura     FacturaFarmacia       @relation(fields: [facturaId], references: [id])
  medicamento MedicamentoInventario @relation(fields: [medicamentoId], references: [id])

  @@index([medicamentoId])
  @@index([facturaId])
}

// Modulo 7: Bitacora de Visitas
model BitacoraVisita {
  id           Int      @id @default(autoincrement())
  pacienteId   Int
  autorId      Int
  descripcion  String
  fecha        DateTime @default(now())

  paciente Paciente @relation(fields: [pacienteId], references: [id])
  autor    Usuario  @relation("BitacoraAutor", fields: [autorId], references: [id])

  @@index([pacienteId])
}
