# Servidor
PORT=4000

# Base de datos (PostgreSQL) -- pendiente de definir host (local vs. nube)
DATABASE_URL=postgresql://usuario:password@localhost:5432/hospital_verapaz

# Autenticacion
JWT_SECRET=cambiar_este_valor
JWT_EXPIRES_IN=8h

# URL del frontend (para armar el enlace de recuperacion de contrasena)
APP_URL=http://localhost:5173

# Adaptador de notificacion: "consola" en laboratorio (registra el enlace en
# consola). El proveedor real de correo se configura al contratarlo.
NOTIFICACION_PROVEEDOR=consola

# Tokens de acceso temporal (RF-33, RF-34)
TEMP_TOKEN_EXPIRES_MIN=15

# Recuperacion de contrasena (Sprint 2). En laboratorio se puede exponer el
# token en la respuesta mientras no haya proveedor de correo; en produccion
# debe ser false y entregarse por correo.
PASSWORD_RESET_EXPIRES_MIN=30
PASSWORD_RESET_EXPOSE_TOKEN=true

# Limites de carga por tipo de archivo (MB)
UPLOAD_MAX_MB_ESTUDIOS=5

# Documentos del paciente: identificaciones, referencias, constancias, el
# expediente escaneado (escaner de camara, Cambios2 + fusion con Anexos)
DOCUMENT_MAX_MB=20
DOCUMENT_MAX_PAGES=30

# Cifrado del diagnostico clinico (RF-10). Debe ser una llave de 32 bytes en hexadecimal (64 caracteres).
# Generarla con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=cambiar_por_64_caracteres_hexadecimales

# Usuario administrador inicial (usado por prisma/seed.js)
SEED_ADMIN_EMAIL=admin@hospitalverapaz.gt
SEED_ADMIN_PASSWORD=CambiarEsta123

# Lectura avanzada de la ficha escaneada con un modelo de vision (OPCIONAL).
# Apagada por defecto: sin ANTHROPIC_API_KEY solo se usa el OCR local
# (Tesseract), que lee bien lo impreso pero casi nada de la letra a mano.
# PRIVACIDAD: al activarla, la imagen de la primera pagina de cada expediente
# escaneado se ENVIA a la API de Anthropic (servicio externo) y la lectura
# tiene costo por uso. Son datos clinicos: activarla es decision del hospital.
# ANTHROPIC_API_KEY=
# Modelo (por defecto claude-opus-5; uno mas economico: claude-sonnet-5)
# ANTHROPIC_MODEL=claude-opus-5
