# Variables para docker compose (instalacion local del hospital).
# Copie este archivo a .env y complete los valores antes de ejecutar
# `docker compose up -d --build`. NUNCA versione el .env real.

# PostgreSQL
POSTGRES_PASSWORD=cambiar_esta_clave

# Secretos del backend
# Generar JWT_SECRET y ENCRYPTION_KEY con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Llave AES-256 de 32 bytes en hexadecimal (exactamente 64 caracteres).
# ATENCION: si se pierde esta llave, los datos clinicos cifrados ya no se
# pueden leer. Guardela en custodia segura junto con el respaldo.
ENCRYPTION_KEY=

# Puerto web del sistema (http://localhost:8080)
FRONTEND_PORT=8080
APP_URL=http://localhost:8080

# Sesiones y tokens
JWT_EXPIRES_IN=8h
TEMP_TOKEN_EXPIRES_MIN=15
PASSWORD_RESET_EXPIRES_MIN=30
# En produccion: false (el token se entrega por el proveedor de correo)
PASSWORD_RESET_EXPOSE_TOKEN=false
NOTIFICACION_PROVEEDOR=consola

# Limites de carga de archivos (MB)
UPLOAD_MAX_MB_ESTUDIOS=5
UPLOAD_MAX_MB_ANEXOS=15

# Administrador inicial (solo se usa en el primer arranque con RUN_SEED=true)
SEED_ADMIN_EMAIL=admin@hospitalverapaz.gt
SEED_ADMIN_PASSWORD=CambiarEsta123

# Migraciones/seed en arranque: dejar true en la instalación inicial;
# pasar a false después para acelerar los reinicios.
RUN_MIGRATIONS=true
RUN_SEED=true
